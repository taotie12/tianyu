<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_title" android:textColor="#1B5040" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <ImageButton android:id="@+id/widget_refresh" android:layout_width="24dp" android:layout_height="24dp" android:padding="3dp" android:src="@drawable/widget_refresh" android:background="@android:color/transparent" android:contentDescription="@string/widget_refresh" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="1dp" android:layout_marginRight="1dp">
      <TextView android:id="@+id/widget_week_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_dash" android:textColor="#687A73" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_date_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#284D40" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_shift_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#137E69" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:background="@drawable/widget_badge_empty" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="1dp" android:layout_marginRight="1dp">
      <TextView android:id="@+id/widget_week_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_dash" android:textColor="#687A73" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_date_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#284D40" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_shift_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#137E69" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:background="@drawable/widget_badge_empty" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="1dp" android:layout_marginRight="1dp">
      <TextView android:id="@+id/widget_week_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_dash" android:textColor="#687A73" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_date_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#284D40" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" />
      <TextView android:id="@+id/widget_shift_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:gravity="center" android:text="@string/widget_dash" android:textColor="#137E69" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:background="@drawable/widget_badge_empty" android:includeFontPadding="false" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/widget_empty" android:textColor="#687A73" android:textSize="11sp" android:visibility="gone" android:includeFontPadding="false" android:maxLines="2" />
  <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/widget_small_subtitle" android:textColor="#49665A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
</LinearLayout>
